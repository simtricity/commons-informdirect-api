{
  "name": "@simtricity-commons/informdirect-api",
  "version": "0.1.2",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "exclude": [
      "tests/",
      "cli/",
      "examples/",
      ".env.example",
      ".github/",
      "CLAUDE.md",
      "INFORMDIRECT_SANDBOX_TESTING.md"
    ]
  },
  "tasks": {
    "check": "deno check mod.ts cli/mod.ts tests/sandbox-test.ts tests/live-test.ts tests/unit-test.ts examples/read-only.ts examples/raw-fetch.ts",
    "test": "deno test tests/unit-test.ts",
    "test:live": "deno test --allow-net --allow-env --allow-read tests/live-test.ts",
    "test:sandbox": "deno test --allow-net --allow-env --allow-read tests/sandbox-test.ts",
    "cli": "deno run --allow-net --allow-env --allow-read cli/mod.ts",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/dotenv/load": "jsr:@std/dotenv@^0.225.8/load",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/cli/parse-args": "jsr:@std/cli@^1.0.32/parse-args"
  }
}
